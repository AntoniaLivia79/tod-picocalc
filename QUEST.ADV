# ================================================================
# QUEST OF THE KING - Tunnels of Doom adventure module
# Lines are KEYWORD,field,field,...   Lines starting # are ignored.
# ================================================================
TITLE,Quest of the King
INTRO,The King is held captive by monsters in the dungeon beneath a ruined castle.
INTRO,Rescue him and recover his rainbow orb of power before they are destroyed. Then return to the surface.
INTRO,Beware - your time is limited!
WIN,The King is safe and his rainbow orb restored. The kingdom rejoices!
FAIL,The kingdom falls into darkness.

# FLOORS,n (1-10)   GRID,width,height (max 14x10)   ROOMS,per generated floor
FLOORS,4
GRID,14,10
ROOMS,16
# starting GOLD per player for difficulty 1,2,3
GOLD,160,130,100
# % chance per hallway step of a wandering monster
WANDER,6
# 1 = a floor's map must be found before descending
NEEDMAP,1
# floors that get a general store room
STORE,3,8
# SEED,0 = new random dungeon each game, other = same dungeon every game
SEED,0

# ITEM,kind,name,v1,v2,cost,classes,unknown-name
# kinds: W hand weapon (v1=damage)   R ranged weapon (v1=damage, v2=ammo group)
#        X ammunition (v1=count, v2=ammo group)   A armor / S shield (v1=protection)
#        P rations (v1=count)   H healing (v1=wounds healed over time)
#        M magic (v1=effect, v2=power): 1 heal 2 cursed/harm 3 fireball-all
#          4 bolt-one 5 reveal map 6 +max HP 7 +bonus
# cost 0 = not sold in the store.  classes: letters F W R H who may use it
